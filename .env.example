# Venda.AI — exemplo de configuração
# NÃO COLOQUE SEGREDOS REAIS NESTE ARQUIVO.

# WhatsApp P0 — Z-API Classic (decisão vigente)
ZAPI_MODE=classic
ZAPI_CLASSIC_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_WEBHOOK_SECRET=

# Z-API Omni preservado como compatibilidade futura, não ativo no P0 atual.
ZAPI_OMNI_BASE_URL=https://api.omni.z-api.io/v1
ZAPI_OMNI_SECRET_KEY=
ZAPI_OMNI_CHANNEL_ID=

# Venda.AI — exemplo de configuração
# NÃO COLOQUE SEGREDOS REAIS NESTE ARQUIVO.

# WhatsApp P0 — Z-API Classic (decisão vigente)
ZAPI_MODE=classic
ZAPI_CLASSIC_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Webhook inbound: gere um valor aleatório forte e mantenha fora do repositório.
ZAPI_WEBHOOK_SECRET=

# Mapeamento server-side instance -> tenant. Exemplo SEM dados reais:
# ZAPI_INSTANCE_TENANT_MAP={"instance-exemplo":"tenant-exemplo"}
ZAPI_INSTANCE_TENANT_MAP={}

# IA P0 — credenciais reais ficam no secret manager/Railway.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=500
# OPENAI_SYSTEM_PROMPT=

# Persistência P0 — conexão server-side com PostgreSQL.
DATABASE_URL=

# Autenticação / frontend público.
# Origem exata da landing publicada, por exemplo https://usuario.github.io
PUBLIC_APP_ORIGIN=
# URL pública usada nos links enviados por e-mail, sem barra final.
PASSWORD_RESET_BASE_URL=
# URL do backend usada pelo Vite durante o build da landing.
VITE_API_BASE_URL=

# E-mail transacional para recuperação de senha.
# Segredos reais ficam no Railway/secret manager.
RESEND_API_KEY=
# Exemplo após validar um remetente/domínio no provedor:
AUTH_EMAIL_FROM=Venda.AI <acesso@seudominio.com>

# Z-API Omni preservado como compatibilidade futura, não ativo no P0 atual.
ZAPI_OMNI_BASE_URL=https://api.omni.z-api.io/v1
ZAPI_OMNI_SECRET_KEY=
ZAPI_OMNI_CHANNEL_ID=

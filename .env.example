# Venda.AI — exemplo de configuração
# NÃO COLOQUE SEGREDOS REAIS NESTE ARQUIVO.

# WhatsApp P0 — Whapi
WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_TOKEN=
# JSON server-side: {"CHANNEL_ID":"TENANT_ID"}
WHAPI_CHANNEL_TENANT_MAP={}

# Integração Z-API preservada como histórico/alternativa até decisão de remoção.
ZAPI_MODE=omni
ZAPI_OMNI_BASE_URL=https://api.omni.z-api.io/v1
ZAPI_OMNI_SECRET_KEY=
ZAPI_OMNI_CHANNEL_ID=
ZAPI_WEBHOOK_SECRET=
